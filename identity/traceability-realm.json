{
  "realm": "traceability",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "reader",
        "description": "Read-only access: can list and view farms, stations and batches."
      },
      {
        "name": "writer",
        "description": "Data entry: can also create farms, batches and movements."
      }
    ]
  },
  "clients": [
    {
      "clientId": "traceability-trial",
      "name": "Traceability trial client (hand trials only, not used by the web interface)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "traceability-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "traceability-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}

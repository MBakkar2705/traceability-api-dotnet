# Copier ce fichier en .env puis renseigner les valeurs. Le fichier .env est ignore par git : ne jamais le commiter.
# Mot de passe du compte "sa" de SQL Server (demonstration seulement).
# Au moins 12 caracteres avec majuscules, minuscules et chiffres, sans symbole.
MSSQL_SA_PASSWORD=
# Mot de passe de l'administrateur de Keycloak (console http://localhost:8180/admin, compte "admin").
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Mot de passe commun aux 4 comptes de demonstration (reader-test, writer-test, supervisor-test, auditor-test).
DEMO_USER_PASSWORD=
